{
    "name": "auto-import-preset",
    "private": false,
    "version": "0.0.2",
    "description": "从 TypeScript 入口文件生成 unplugin-auto-import 的 preset 名单；支持在导出定义处用 JSDoc 标记（默认 @noAutoImport）把内部导出排除在外。Generate an unplugin-auto-import preset from a TypeScript entry file, with per-declaration opt-out via JSDoc tags.",
    "type": "module",
    "license": "MIT",
    "author": "hsianglee",
    "repository": {
        "type": "git",
        "url": "https://github.com/hsiangleev/auto-import-preset"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "auto-import-preset": "./dist/cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "npm run build && node --test",
        "prepack": "npm run build",
        "prepublishOnly": "npm test"
    },
    "peerDependencies": {
        "typescript": ">=4.7"
    },
    "devDependencies": {
        "@types/node": "^24.10.0",
        "typescript": "^5.9.2"
    },
    "keywords": [
        "auto-import",
        "unplugin-auto-import",
        "preset",
        "typescript",
        "exports",
        "codegen"
    ]
}
